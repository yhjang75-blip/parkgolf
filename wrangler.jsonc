{
  // 나이스파크 — Cloudflare Workers 무료 요금제 설정
  // 배포: GitHub 에 올리면 .github/workflows/deploy-cloudflare.yml 이 자동으로 배포
  // 내 PC 시험: npx wrangler dev  →  http://localhost:8787
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nicepark",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-17",
  "observability": { "enabled": true },
  // 배포·시험 직전에 화면 틀과 구장 자료를 준비
  "build": { "command": "node scripts/build-worker.mjs" },
  // 구장 자료·CSS·JS 는 정적 파일로 (무료·무제한)
  "assets": { "directory": "public", "binding": "ASSETS" },
  // 회원·대회 자료 (D1). 처음 배포할 때 Cloudflare 가 데이터베이스를 자동으로 만든다.
  // 20분마다 뉴스·영상을 미리 받아 둠 (구글이 가끔 Cloudflare 요청을 막아서)
  "triggers": { "crons": ["*/20 * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "nicepark" }],
  // 게시판 사진 (KV 무료: 저장 1GB, 하루 읽기 10만·쓰기 1천). 처음 배포 때 자동으로 만들어짐.
  "kv_namespaces": [{ "binding": "PHOTOS" }]
}
